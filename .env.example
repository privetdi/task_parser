# Образец настроек. Скопируйте в `.env` (в корне репозитория) и поправьте под себя.
# Все параметры необязательны: значения ниже — значения по умолчанию.

# --- Почта ---------------------------------------------------------------
# dry-run — письма не отправляются, а сохраняются как .eml в DATA_DIR/outbox
# smtp    — реальная отправка через SMTP-сервер (нужны SMTP_HOST и MAIL_TO)
MAIL_MODE=dry-run
MAIL_FROM=rates@localhost
# Получатели через запятую
MAIL_TO=recipient@example.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls

# --- Расписание (cron: минута час день месяц день_недели) -----------------
TIMEZONE=Europe/Minsk
# Проверка новых и изменённых курсов
CRON_RATES_SYNC=0 8 * * *
# Формирование и отправка Excel-отчёта
CRON_RATES_REPORT=0 9 * * *
# Проверка каталога графиков IEA и отправка новых
CRON_IEA_CHARTS=0 10 * * *

# --- Курсы НБ РБ ---------------------------------------------------------
# С какой даты загружать историю (2016-07-01 — деноминация, раньше курсы в иных единицах)
BACKFILL_START=2016-07-01
# Продолжать незавершённую загрузку истории при старте сервиса
BACKFILL_ON_STARTUP=true
# Сколько последних дней перепроверять при ежедневной проверке (ловит изменённые курсы)
SYNC_LOOKBACK_DAYS=30
# Пауза между запросами к API НБ РБ, секунды
NBRB_REQUEST_DELAY=0.1

# --- Графики IEA ---------------------------------------------------------
# Сайт IEA может показать проверку «Verify you are human». Автоматически её не обходим:
# пройдите её один раз сами, командой (в каталоге backend/, сервис остановлен):
#   uv run python -m app.sources.iea_login
# Допуск сохраняется в профиле браузера и действует на следующие запуски, пока сайт не
# потребует проверку снова. Если нужно, повторите команду.
# false — окно браузера видно. С профилем для регулярных запусков лучше false:
# допуск, полученный в окне, в headless-режиме может не приниматься.
IEA_HEADLESS=true
# chromium — браузер, встроенный в Playwright; chrome — установленный Google Chrome
IEA_BROWSER_CHANNEL=chromium
# Профиль браузера (cookie и допуск сайта). По умолчанию — DATA_DIR/browser-profile
# IEA_PROFILE_DIR=../data/browser-profile

# --- Пути ----------------------------------------------------------------
# Здесь лежат БД, письма (outbox/), графики (charts/) и отчёты (reports/).
# Путь считается от каталога backend/, откуда запускается сервис.
DATA_DIR=../data
# Собранный frontend (npm run build). Если каталога нет, работает только API.
# FRONTEND_DIST=../frontend/dist
